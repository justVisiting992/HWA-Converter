<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Deliberately NO android.permission.INTERNET: every conversion happens
         on-device. This is a feature, and it stays. -->

    <!-- Keeping conversions alive in the background: the foreground
         service permission, its data-sync type, and notifications. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MediaConverter">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MediaConverter" />

        <!-- Selectable launcher icons (Settings tab): one alias per
             icon carries the LAUNCHER entry; exactly one is enabled at
             a time, switched at runtime by the icon picker. -->
        <activity-alias
            android:name=".icon.IconDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.IconDusk"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_dusk"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
