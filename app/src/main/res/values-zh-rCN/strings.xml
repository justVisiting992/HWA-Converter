    <string name="about_check_updates">检查更新</string>
    <string name="about_check_updates_sub">在 GitHub 上查看是否有新版本</string>
    <string name="about_auto_check">自动检查更新</string>
    <string name="about_auto_off">已关闭。此应用无法访问网络。</string>
    <string name="about_auto_daily">每天在应用打开时一次</string>
    <string name="about_internet_note">互联网权限随安装一起提供，仅用于在 GitHub 上检查更新。如果您不需要更新检查，请关闭自动检查。如果应用无法访问互联网，检查器会自行停用，直到可以访问为止。</string>
    <string name="about_replay_tour">重播导览</string>
    <string name="about_replay_tour_sub">再次查看功能导览</string>
