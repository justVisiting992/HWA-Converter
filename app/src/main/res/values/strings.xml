    <!-- Presets: labels and descriptions -->
    <string name="preset_h264_hw_label">H.264 · hardware</string>
    <string name="preset_h264_hw_desc">Fast, small, plays everywhere. Uses this phone\'s media engine.</string>
    <string name="preset_hevc_hw_label">H.265 / HEVC · hardware</string>
    <string name="preset_hevc_hw_desc">About half the size of H.264 at the same quality. Uses this phone\'s media engine.</string>
    <string name="preset_vp9_hw_label">VP9 · hardware</string>
    <string name="preset_vp9_hw_desc">Hardware VP9 in a WebM file. Only on phones whose media engine encodes VP9.</string>
    <string name="preset_av1_hw_label">AV1 · hardware</string>
    <string name="preset_av1_hw_desc">Hardware AV1. Only a few media engines can encode AV1, so this preset appears only on those phones.</string>
    <string name="preset_h264_sw_label">H.264 · max quality (software)</string>
    <string name="preset_h264_sw_desc">Slow CPU encode with libx264, best quality per byte. For masters and HDR.</string>
    <string name="preset_hevc_sw_label">H.265 / HEVC · max quality (software)</string>
    <string name="preset_hevc_sw_desc">Smaller than H.264 at the same quality. Slow CPU encode with libx265.</string>
    <string name="preset_vp9_sw_label">VP9 · software (WebM)</string>
    <string name="preset_vp9_sw_desc">The web\'s codec, in a WebM file. CPU encode with libvpx.</string>
    <string name="preset_av1_sw_label">AV1 · software</string>
    <string name="preset_av1_sw_desc">Newest codec, smallest files. Very slow on CPU. Best for short clips.</string>
    <string name="preset_audio_aac_label">Audio only · AAC</string>
    <string name="preset_audio_aac_desc">Extract the audio track to AAC.</string>
    <string name="preset_audio_mp3_label">Audio only · MP3</string>
    <string name="preset_audio_mp3_desc">Extract the audio track to MP3. Plays everywhere.</string>
    <string name="preset_audio_opus_label">Audio only · Opus</string>
    <string name="preset_audio_opus_desc">Extract the audio track to Opus. Smallest at the same quality.</string>
    <string name="preset_audio_flac_label">Audio only · FLAC</string>
    <string name="preset_audio_flac_desc">Extract the audio track losslessly to FLAC.</string>
    <string name="preset_audio_wav_label">Audio only · WAV</string>
    <string name="preset_audio_wav_desc">Extract the audio track uncompressed to WAV, for editing.</string>
    <string name="preset_remux_mp4_label">Remux to MP4 · no re-encode</string>
    <string name="preset_remux_mp4_desc">Same picture and sound, new MP4 container. Instant.</string>
    <string name="preset_remux_mkv_label">Remux to MKV · no re-encode</string>
    <string name="preset_remux_mkv_desc">Same picture and sound, new MKV container. Instant.</string>
    <string name="preset_trim_label">Trim · no re-encode</string>
    <string name="preset_trim_desc">Cut a section out without touching the picture. Cuts land on keyframes.</string>
    <string name="preset_gif_label">GIF · animated image</string>
    <string name="preset_gif_desc">Turn a clip into an animated GIF (12 fps, 480 px wide). Short clips only.</string>
    <string name="preset_custom_label">Custom · manual settings</string>
    <string name="preset_custom_desc">Your own format: container, codecs, bitrate, resolution.</string>

    <!-- Job notes and refusals (PresetCommands) -->
    <string name="note_sw_x264">Software encode (libx264, CRF 18, slow preset). Slow, best quality per byte. Decode: %1$s.</string>
    <string name="note_sw_x265">Software encode (libx265, CRF 22, medium preset). Decode: %1$s.</string>
    <string name="note_sw_vp9">Software encode (libvpx-vp9, CRF 30) to WebM. Decode: %1$s.</string>
    <string name="note_sw_av1">Software encode (libaom-av1, CRF 32). AV1 on CPU is very slow. Decode: %1$s.</string>
    <string name="note_audio_aac">Audio extraction to AAC 192k. No video encoder involved.</string>
    <string name="note_audio_mp3">Audio extraction to MP3 192k. No video encoder involved.</string>
    <string name="note_audio_opus">Audio extraction to Opus 128k. No video encoder involved.</string>
    <string name="note_audio_flac">Audio extraction to FLAC (lossless). No video encoder involved.</string>
    <string name="note_audio_wav">Audio extraction to WAV (uncompressed). No video encoder involved.</string>
    <string name="note_remux_mp4">Remux to MP4: streams copied, nothing re-encoded.</string>
    <string name="note_remux_mkv">Remux to MKV: streams copied, nothing re-encoded.</string>
    <string name="note_gif">Animated GIF at 12 fps, 480 px wide. Decode: %1$s.</string>
    <string name="note_trim">Stream copy, no re-encode. Cuts land on keyframes, so the edges may shift a few frames.</string>
    <string name="note_hw_encode">Hardware encode (%1$s) on %2$s at %3$s Mbps. Decode: %4$s.</string>
    <string name="note_custom_audio">Custom: audio only (%1$s %2$dk).</string>
    <string name="note_custom_full">Custom: %1$s · video %2$s · audio %3$s. Decode: %4$s.</string>
