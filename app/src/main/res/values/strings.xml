    <!-- About -->
    <string name="about_tagline">Hardware-first media conversion</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_body">Hardware Accelerated Converter puts your phone\'s media engine to work. Most converter apps ignore it and encode on the CPU. This app probes the chip first and uses the hardware whenever it can. The software path stays for maximum quality and for jobs the hardware cannot do. Nothing falls back silently. Every job shows the exact command that ran, and the Hardware tab shows what your phone can do. The app is free and open source. Your files never leave your phone: the only thing the app ever fetches is its own updates, from GitHub.</string>
    <string name="about_github">GitHub</string>
    <string name="about_github_sub">Source code, issues and the project page</string>
    <string name="about_releases">Releases</string>
    <string name="about_releases_sub">Download the latest APKs</string>
    <string name="about_check_updates">Check for updates</string>
    <string name="about_check_updates_sub">Check GitHub for a newer version</string>
    <string name="about_auto_check">Automatic update check</string>
    <string name="about_auto_off">Off. The app has no network access.</string>
    <string name="about_auto_daily">Once a day, when the app opens</string>
    <string name="about_internet_note">The internet permission comes with the install and is used only to check GitHub for updates. If you do not need update checks, switch the automatic check off. If the app cannot reach the internet, the checker disables itself until it can.</string>
    <string name="about_replay_tour">Replay the tour</string>
    <string name="about_replay_tour_sub">See the feature tour again</string>
    <string name="about_footer">Built on FFmpeg through FFmpegKit (GPL), running on your phone\'s media hardware.</string>

    <!-- Feature tour -->
    <string name="tour_welcome_title">Welcome to HWA Converter</string>
    <string name="tour_welcome_body">This app converts video and audio on your phone. It uses the media engine first, not the CPU. Here is a quick look around.</string>
    <string name="tour_add_title">Add files</string>
    <string name="tour_add_body">Tap this button and pick your files. Nothing starts yet. They wait until you tap Start.</string>
    <string name="tour_pick_title">Pick a conversion</string>
    <string name="tour_pick_body">Hardware presets are fast and easy on the battery. Software presets are slower but give the best quality. Custom lets you set everything yourself.</string>
    <string name="tour_start_title">Start when you\'re ready</string>
    <string name="tour_start_body">After you add files, a Start button appears under Add files. Tap it to begin. Until then, nothing runs.</string>
    <string name="tour_queue_title">The Queue tab</string>
    <string name="tour_queue_body">All your conversions live here. You can watch progress and speed, see the exact command that ran, and save a job\'s debug log.</string>
    <string name="tour_hardware_title">Your hardware</string>
    <string name="tour_hardware_body">This is the media engine inside your phone, probed on this device. Your presets are built from it. If a hardware path is not listed, your chip does not have it.</string>
    <string name="tour_settings_title">Look &amp; Feel</string>
    <string name="tour_settings_body">Themes, color schemes, language, and nine launcher icons live here.</string>
    <string name="tour_done_title">That\'s it</string>
    <string name="tour_done_body">One last thing. Conversions run entirely on your phone. The only thing the app ever downloads is its own updates.</string>
