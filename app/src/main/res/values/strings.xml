    <string name="refusal_pick_audio">Pick an audio codec.</string>
    <string name="refusal_webm_video">WebM holds VP9 or AV1 video. Pick one of those, or use an MP4 or MKV container.</string>
    <string name="refusal_webm_audio">WebM audio must be Opus, copied, or none. AAC and MP3 do not fit WebM.</string>
