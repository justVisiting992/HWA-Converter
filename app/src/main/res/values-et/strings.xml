    <!-- About -->
    <string name="about_tagline">Riistvarapõhine meediateisendus</string>
    <string name="about_version">Versioon %1$s</string>
    <string name="about_body">Hardware Accelerated Converter paneb sinu telefoni meediamootori tööle. Enamik teisendusrakendusi eirab seda ja kodeerib protsessoril. See rakendus uurib esmalt kiipi ja kasutab riistvara alati, kui saab. Tarkvaratee jääb parima kvaliteedi jaoks ja tööde jaoks, mida riistvara ei suuda teha. Midagi ei asendata vaikselt. Iga töö näitab täpset käsku, mis käivitati, ja vahekaart Riistvara näitab, mida sinu telefon suudab. Rakendus on tasuta ja avatud lähtekoodiga. Sinu failid ei lahku kunagi telefonist: ainus asi, mida rakendus kunagi alla laadib, on selle enda värskendused GitHubist.</string>
    <string name="about_github">GitHub</string>
    <string name="about_github_sub">Lähtekood, probleemid ja projekti leht</string>
    <string name="about_releases">Väljalasked</string>
    <string name="about_releases_sub">Laadi alla uusimad APK-d</string>
    <string name="about_check_updates">Kontrolli värskendusi</string>
    <string name="about_check_updates_sub">Kontrolli GitHubist uuemat versiooni</string>
    <string name="about_auto_check">Automaatne värskenduste kontroll</string>
    <string name="about_auto_off">Väljas. Rakendusel pole võrguühendust.</string>
    <string name="about_auto_daily">Kord päevas, kui rakendus avaneb</string>
    <string name="about_internet_note">Interneti-luba tuleb koos installiga ja seda kasutatakse ainult GitHubist värskenduste kontrollimiseks. Kui sa värskenduste kontrolli ei vaja, lülita automaatne kontroll välja. Kui rakendus ei pääse internetti, keelab kontroll end ise, kuni ühendus taastub.</string>
    <string name="about_replay_tour">Esita tutvustus uuesti</string>
    <string name="about_replay_tour_sub">Vaata funktsioonide tutvustust uuesti</string>
    <string name="about_footer">Ehitatud FFmpegile FFmpegKiti (GPL) kaudu, töötab sinu telefoni meediariistvaral.</string>

    <!-- Feature tour -->
    <string name="tour_welcome_title">Tere tulemast rakendusse HWA Converter</string>
    <string name="tour_welcome_body">See rakendus teisendab sinu telefonil videot ja heli. See kasutab esmalt meediamootorit, mitte protsessorit. Siin on kiire ülevaade.</string>
    <string name="tour_add_title">Lisa failid</string>
    <string name="tour_add_body">Puuduta seda nuppu ja vali oma failid. Midagi ei käivitu veel. Need ootavad, kuni puudutad nuppu Start.</string>
    <string name="tour_pick_title">Vali teisendus</string>
    <string name="tour_pick_body">Riistvara eelseaded on kiired ja säästavad akut. Tarkvara eelseaded on aeglasemad, kuid annavad parima kvaliteedi. Kohandatud valik laseb sul kõik ise seadistada.</string>
    <string name="tour_start_title">Alusta, kui valmis oled</string>
    <string name="tour_start_body">Pärast failide lisamist ilmub nupu Lisa failid alla nupp Start. Alustamiseks puuduta seda. Seni ei tööta midagi.</string>
    <string name="tour_queue_title">Vahekaart Järjekord</string>
    <string name="tour_queue_body">Kõik sinu teisendused on siin. Saad jälgida edenemist ja kiirust, näha täpset käsku, mis käivitati, ja salvestada töö silumislogi.</string>
    <string name="tour_hardware_title">Sinu riistvara</string>
    <string name="tour_hardware_body">See on sinu telefoni sees olev meediamootor, uuritud sellel seadmel. Sinu eelseaded on koostatud selle põhjal. Kui riistvara teed loendis pole, siis sinu kiibil seda pole.</string>
    <string name="tour_settings_title">Välimus</string>
    <string name="tour_settings_body">Teemad, värviskeemid, keel ja üheksa käivitaja ikooni on siin.</string>
    <string name="tour_done_title">Ongi kõik</string>
    <string name="tour_done_body">Veel üks asi. Teisendused töötavad täielikult sinu telefonil. Ainus asi, mida rakendus kunagi alla laadib, on selle enda värskendused.</string>
    <string name="tour_skip">Jäta vahele</string>
    <string name="tour_next">Edasi</string>
    <string name="tour_got_it">Selge</string>

