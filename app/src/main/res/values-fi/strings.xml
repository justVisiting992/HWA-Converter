    <!-- About -->
    <string name="about_tagline">Mediamuunnos laitteisto edellä</string>
    <string name="about_version">Versio %1$s</string>
    <string name="about_body">Hardware Accelerated Converter laittaa puhelimesi mediamoottorin töihin. Useimmat muunnossovellukset ohittavat sen ja koodaavat suorittimella. Tämä sovellus tutkii sirun ensin ja käyttää laitteistoa aina kun voi. Ohjelmistopolku jää enimmäislaatua varten ja töihin, joita laitteisto ei pysty tekemään. Mikään ei palaa äänettömästi takaisin. Jokainen työ näyttää tarkan ajetun komennon, ja Laitteisto-välilehti näyttää, mihin puhelimesi pystyy. Sovellus on ilmainen ja avointa lähdekoodia. Tiedostosi eivät koskaan poistu puhelimestasi: ainoa asia, jonka sovellus koskaan hakee, ovat sen omat päivitykset GitHubista.</string>
    <string name="about_github">GitHub</string>
    <string name="about_github_sub">Lähdekoodi, ongelmat ja projektisivu</string>
    <string name="about_releases">Julkaisut</string>
    <string name="about_releases_sub">Lataa uusimmat APK:t</string>
    <string name="about_check_updates">Tarkista päivitykset</string>
    <string name="about_check_updates_sub">Tarkista GitHubista uudempi versio</string>
    <string name="about_auto_check">Automaattinen päivitystarkistus</string>
    <string name="about_auto_off">Pois. Sovelluksella ei ole verkkoyhteyttä.</string>
    <string name="about_auto_daily">Kerran päivässä, kun sovellus avautuu</string>
    <string name="about_internet_note">Internet-lupa tulee asennuksen mukana, ja sitä käytetään vain GitHubin päivitysten tarkistamiseen. Jos et tarvitse päivitystarkistuksia, kytke automaattinen tarkistus pois päältä. Jos sovellus ei tavoita internetiä, tarkistus poistaa itsensä käytöstä, kunnes se taas voi.</string>
    <string name="about_replay_tour">Toista esittely</string>
    <string name="about_replay_tour_sub">Katso ominaisuusesittely uudelleen</string>
    <string name="about_footer">Rakennettu FFmpegin päälle FFmpegKitin (GPL) kautta, ajetaan puhelimesi medialaitteistolla.</string>

    <!-- Feature tour -->
    <string name="tour_welcome_title">Tervetuloa HWA Converteriin</string>
    <string name="tour_welcome_body">Tämä sovellus muuntaa videota ja ääntä puhelimessasi. Se käyttää ensin mediamoottoria, ei suoritinta. Tässä nopea kierros.</string>
    <string name="tour_add_title">Lisää tiedostoja</string>
    <string name="tour_add_body">Napauta tätä painiketta ja valitse tiedostosi. Mikään ei käynnisty vielä. Ne odottavat, kunnes napautat Aloita.</string>
    <string name="tour_pick_title">Valitse muunnos</string>
    <string name="tour_pick_body">Laitteistoesiasetukset ovat nopeita ja säästävät akkua. Ohjelmistoesiasetukset ovat hitaampia, mutta antavat parhaan laadun. Mukautetulla voit asettaa kaiken itse.</string>
    <string name="tour_start_title">Aloita, kun olet valmis</string>
    <string name="tour_start_body">Kun olet lisännyt tiedostoja, Lisää tiedostoja -kohdan alle ilmestyy Aloita-painike. Aloita napauttamalla sitä. Siihen asti mikään ei käynnisty.</string>
    <string name="tour_queue_title">Jono-välilehti</string>
    <string name="tour_queue_body">Kaikki muunnoksesi ovat täällä. Voit seurata edistymistä ja nopeutta, nähdä tarkan ajetun komennon ja tallentaa työn vianmäärityslokin.</string>
    <string name="tour_hardware_title">Laitteistosi</string>
    <string name="tour_hardware_body">Tämä on puhelimesi sisällä oleva mediamoottori, tutkittu tällä laitteella. Esiasetuksesi rakennetaan siitä. Jos laitteistopolkua ei ole luettelossa, sirussasi ei ole sitä.</string>
    <string name="tour_settings_title">Ulkoasu</string>
    <string name="tour_settings_body">Teemat, värimallit, kieli ja yhdeksän käynnistysohjelman kuvaketta ovat täällä.</string>
    <string name="tour_done_title">Siinä kaikki</string>
    <string name="tour_done_body">Vielä yksi asia. Muunnokset ajetaan kokonaan puhelimessasi. Ainoa asia, jonka sovellus koskaan lataa, ovat sen omat päivitykset.</string>
    <string name="tour_skip">Ohita</string>
    <string name="tour_next">Seuraava</string>
    <string name="tour_got_it">Selvä</string>

