    <!-- About -->
    <string name="about_tagline">하드웨어 우선 미디어 변환</string>
    <string name="about_version">버전 %1$s</string>
    <string name="about_body">Hardware Accelerated Converter는 휴대전화의 미디어 엔진을 활용합니다. 대부분의 변환 앱은 이를 무시하고 CPU로 인코딩합니다. 이 앱은 먼저 칩을 확인하고 가능할 때마다 하드웨어를 사용합니다. 소프트웨어 경로는 최고 품질을 위해, 그리고 하드웨어가 할 수 없는 작업을 위해 남아 있습니다. 조용히 대체되는 경우는 없습니다. 모든 작업에는 실제 실행된 명령이 표시되고, 하드웨어 탭에서는 휴대전화의 성능을 볼 수 있습니다. 이 앱은 무료 오픈 소스입니다. 파일이 휴대전화 밖으로 나가는 일은 없습니다. 이 앱이 가져오는 것은 GitHub에서 받는 자체 업데이트뿐입니다.</string>
    <string name="about_github">GitHub</string>
    <string name="about_github_sub">소스 코드, 이슈, 프로젝트 페이지</string>
    <string name="about_releases">릴리스</string>
    <string name="about_releases_sub">최신 APK 다운로드</string>
    <string name="about_check_updates">업데이트 확인</string>
    <string name="about_check_updates_sub">GitHub에서 새 버전 확인</string>
    <string name="about_auto_check">자동 업데이트 확인</string>
    <string name="about_auto_off">꺼짐. 이 앱에는 네트워크 액세스 권한이 없습니다.</string>
    <string name="about_auto_daily">앱을 열 때 하루에 한 번</string>
    <string name="about_internet_note">인터넷 권한은 설치 시 함께 제공되며 GitHub에서 업데이트를 확인하는 데만 사용됩니다. 업데이트 확인이 필요 없으면 자동 확인을 끄세요. 앱이 인터넷에 연결할 수 없으면, 연결할 수 있을 때까지 확인 기능이 자동으로 비활성화됩니다.</string>
    <string name="about_replay_tour">둘러보기 다시 보기</string>
    <string name="about_replay_tour_sub">기능 둘러보기를 다시 봅니다</string>
    <string name="about_footer">FFmpegKit(GPL)를 통한 FFmpeg로 만들었으며, 휴대전화의 미디어 하드웨어에서 실행됩니다.</string>

    <!-- Feature tour -->
    <string name="tour_welcome_title">HWA Converter에 오신 것을 환영합니다</string>
    <string name="tour_welcome_body">이 앱은 휴대전화에서 동영상과 오디오를 변환합니다. CPU가 아닌 미디어 엔진을 먼저 사용합니다. 간단히 둘러보겠습니다.</string>
    <string name="tour_add_title">파일 추가</string>
    <string name="tour_add_body">이 버튼을 눌러 파일을 선택하세요. 아직 시작되지 않습니다. 시작을 누를 때까지 기다립니다.</string>
    <string name="tour_pick_title">변환 선택</string>
    <string name="tour_pick_body">하드웨어 프리셋은 빠르고 배터리에 부담이 적습니다. 소프트웨어 프리셋은 느리지만 최고의 품질을 제공합니다. 사용자 지정에서는 모든 것을 직접 설정할 수 있습니다.</string>
    <string name="tour_start_title">준비되면 시작</string>
    <string name="tour_start_body">파일을 추가하면 파일 추가 버튼 아래에 시작 버튼이 나타납니다. 누르면 시작됩니다. 그전에는 아무것도 실행되지 않습니다.</string>
    <string name="tour_queue_title">대기열 탭</string>
    <string name="tour_queue_body">모든 변환이 여기에 있습니다. 진행률과 속도를 보고, 실행된 정확한 명령을 확인하고, 작업의 디버그 로그를 저장할 수 있습니다.</string>
    <string name="tour_hardware_title">내 하드웨어</string>
    <string name="tour_hardware_body">이 기기에서 확인한, 휴대전화 내부의 미디어 엔진입니다. 프리셋은 이를 바탕으로 만들어집니다. 하드웨어 경로가 목록에 없으면 칩에 없는 것입니다.</string>
    <string name="tour_settings_title">디자인</string>
    <string name="tour_settings_body">테마, 색상 구성, 언어, 9개의 런처 아이콘이 여기에 있습니다.</string>
    <string name="tour_done_title">여기까지입니다</string>
    <string name="tour_done_body">마지막으로 한 가지. 변환은 전적으로 휴대전화에서 실행됩니다. 이 앱이 다운로드하는 것은 자체 업데이트뿐입니다.</string>
