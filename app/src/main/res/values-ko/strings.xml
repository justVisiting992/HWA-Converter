    <!-- Presets: labels and descriptions -->
    <string name="preset_h264_hw_label">H.264 · 하드웨어</string>
    <string name="preset_h264_hw_desc">빠르고 작으며 어디서나 재생됩니다. 이 휴대전화의 미디어 엔진을 사용합니다.</string>
    <string name="preset_hevc_hw_label">H.265 / HEVC · 하드웨어</string>
    <string name="preset_hevc_hw_desc">같은 품질에서 H.264의 약 절반 크기입니다. 이 휴대전화의 미디어 엔진을 사용합니다.</string>
    <string name="preset_vp9_hw_label">VP9 · 하드웨어</string>
    <string name="preset_vp9_hw_desc">WebM 파일로 하드웨어 VP9 인코딩. 미디어 엔진이 VP9을 인코딩할 수 있는 휴대전화에서만 사용할 수 있습니다.</string>
    <string name="preset_av1_hw_label">AV1 · 하드웨어</string>
    <string name="preset_av1_hw_desc">하드웨어 AV1. AV1을 인코딩할 수 있는 미디어 엔진은 적어서, 이 프리셋은 해당 휴대전화에서만 표시됩니다.</string>
    <string name="preset_h264_sw_label">H.264 · 최고 품질(소프트웨어)</string>
    <string name="preset_h264_sw_desc">libx264를 이용한 느린 CPU 인코딩, 바이트당 최고의 품질. 마스터와 HDR용.</string>
    <string name="preset_hevc_sw_label">H.265 / HEVC · 최고 품질(소프트웨어)</string>
    <string name="preset_hevc_sw_desc">같은 품질에서 H.264보다 작습니다. libx265를 이용한 느린 CPU 인코딩.</string>
    <string name="preset_vp9_sw_label">VP9 · 소프트웨어(WebM)</string>
    <string name="preset_vp9_sw_desc">웹의 코덱을 WebM 파일로. libvpx를 이용한 CPU 인코딩.</string>
    <string name="preset_av1_sw_label">AV1 · 소프트웨어</string>
    <string name="preset_av1_sw_desc">최신 코덱, 가장 작은 파일. CPU에서는 매우 느립니다. 짧은 클립에 적합.</string>
    <string name="preset_audio_aac_label">오디오만 · AAC</string>
    <string name="preset_audio_aac_desc">오디오 트랙을 AAC로 추출합니다.</string>
    <string name="preset_audio_mp3_label">오디오만 · MP3</string>
    <string name="preset_audio_mp3_desc">오디오 트랙을 MP3로 추출합니다. 어디서나 재생됩니다.</string>
    <string name="preset_audio_opus_label">오디오만 · Opus</string>
    <string name="preset_audio_opus_desc">오디오 트랙을 Opus로 추출합니다. 같은 품질에서 가장 작습니다.</string>
    <string name="preset_audio_flac_label">오디오만 · FLAC</string>
    <string name="preset_audio_flac_desc">오디오 트랙을 FLAC로 무손실 추출합니다.</string>
    <string name="preset_audio_wav_label">오디오만 · WAV</string>
    <string name="preset_audio_wav_desc">오디오 트랙을 WAV로 무압축 추출합니다. 편집용.</string>
    <string name="preset_remux_mp4_label">MP4로 리먹스 · 다시 인코딩 안 함</string>
    <string name="preset_remux_mp4_desc">영상과 소리는 그대로, 새 MP4 컨테이너로. 즉시 완료됩니다.</string>
    <string name="preset_remux_mkv_label">MKV로 리먹스 · 다시 인코딩 안 함</string>
    <string name="preset_remux_mkv_desc">영상과 소리는 그대로, 새 MKV 컨테이너로. 즉시 완료됩니다.</string>
    <string name="preset_trim_label">자르기 · 다시 인코딩 안 함</string>
    <string name="preset_trim_desc">영상을 건드리지 않고 구간을 잘라냅니다. 자르는 위치는 키프레임에 맞춰집니다.</string>
    <string name="preset_gif_label">GIF · 움직이는 이미지</string>
    <string name="preset_gif_desc">클립을 움직이는 GIF(12 fps, 너비 480 px)로 만듭니다. 짧은 클립 전용.</string>
    <string name="preset_custom_label">사용자 지정 · 수동 설정</string>
    <string name="preset_custom_desc">직접 정하는 형식: 컨테이너, 코덱, 비트레이트, 해상도.</string>

    <!-- Job notes and refusals (PresetCommands) -->
    <string name="note_sw_x264">소프트웨어 인코딩(libx264, CRF 18, slow 프리셋). 느리지만 바이트당 최고의 품질. 디코딩: %1$s.</string>
    <string name="note_sw_x265">소프트웨어 인코딩(libx265, CRF 22, medium 프리셋). 디코딩: %1$s.</string>
    <string name="note_sw_vp9">WebM으로 소프트웨어 인코딩(libvpx-vp9, CRF 30). 디코딩: %1$s.</string>
    <string name="note_sw_av1">소프트웨어 인코딩(libaom-av1, CRF 32). CPU에서 AV1은 매우 느립니다. 디코딩: %1$s.</string>
    <string name="note_audio_aac">AAC 192k로 오디오 추출. 동영상 인코더를 사용하지 않습니다.</string>
    <string name="note_audio_mp3">MP3 192k로 오디오 추출. 동영상 인코더를 사용하지 않습니다.</string>
    <string name="note_audio_opus">Opus 128k로 오디오 추출. 동영상 인코더를 사용하지 않습니다.</string>
    <string name="note_audio_flac">FLAC(무손실)로 오디오 추출. 동영상 인코더를 사용하지 않습니다.</string>
    <string name="note_audio_wav">WAV(무압축)로 오디오 추출. 동영상 인코더를 사용하지 않습니다.</string>
    <string name="note_remux_mp4">MP4로 리먹스: 스트림을 복사하고 다시 인코딩하지 않습니다.</string>
    <string name="note_remux_mkv">MKV로 리먹스: 스트림을 복사하고 다시 인코딩하지 않습니다.</string>
    <string name="note_gif">12 fps, 너비 480 px의 움직이는 GIF. 디코딩: %1$s.</string>
    <string name="note_trim">스트림 복사, 다시 인코딩 안 함. 자르는 위치가 키프레임에 맞춰져서 가장자리가 몇 프레임 이동할 수 있습니다.</string>
    <string name="note_hw_encode">%2$s에서 하드웨어 인코딩(%1$s), %3$s Mbps. 디코딩: %4$s.</string>
    <string name="note_custom_audio">사용자 지정: 오디오만(%1$s %2$dk).</string>
    <string name="note_custom_full">사용자 지정: %1$s · 동영상 %2$s · 오디오 %3$s. 디코딩: %4$s.</string>
    <string name="refusal_custom_path">사용자 지정 작업은 프리셋이 아닌 수동 옵션으로 만들어집니다.</string>
    <string name="refusal_trim_times">먼저 시작 시간과 종료 시간을 선택하세요. 자르기에는 둘 다 필요합니다.</string>
    <string name="refusal_no_hw_encoder">이 휴대전화에는 하드웨어 %1$s 인코더가 없어서 하드웨어 프리셋을 실행할 수 없습니다. 소프트웨어 프리셋으로는 CPU에서 이 변환을 계속할 수 있습니다.</string>
    <string name="refusal_no_hw_encoder_manual">이 휴대전화에는 하드웨어 %1$s 인코더가 없어서 이 사용자 지정 설정을 실행할 수 없습니다.</string>
    <string name="refusal_legacy_vp9_av1">레거시 엔진(FFmpeg 6.0)에는 VP9 및 AV1 하드웨어 인코더가 없습니다. 소프트웨어 옵션을 선택하거나 H.264 / HEVC 하드웨어를 선택하세요.</string>
    <string name="refusal_audio_only_codec">오디오만 출력하려면 오디오 코덱이 필요합니다. AAC, MP3, Opus 중에서 선택하세요.</string>
    <string name="refusal_pick_audio">오디오 코덱을 선택하세요.</string>
    <string name="refusal_webm_video">WebM에는 VP9 또는 AV1 동영상이 들어갑니다. 둘 중 하나를 선택하거나 MP4 또는 MKV 컨테이너를 사용하세요.</string>
    <string name="refusal_webm_audio">WebM 오디오는 Opus, 복사, 없음 중 하나여야 합니다. AAC와 MP3는 WebM에 들어가지 않습니다.</string>
