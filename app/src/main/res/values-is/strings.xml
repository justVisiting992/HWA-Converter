    <!-- About -->
    <string name="about_tagline">Miðlunarumbreyting með vélbúnaðinn fyrst</string>
    <string name="about_version">Útgáfa %1$s</string>
    <string name="about_body">Hardware Accelerated Converter lætur miðlunarvél símans þíns vinna. Flest umbreytingarforrit hunsa hana og kóða á örgjörvanum. Þetta forrit kannar flöguna fyrst og notar vélbúnaðinn alltaf þegar það getur. Hugbúnaðarleitin er áfram fyrir hámarksgæði og fyrir verk sem vélbúnaðurinn getur ekki gert. Engu er skipt út í þögn. Sérhvert verk sýnir nákvæmlega þá skipun sem var keyrð, og Vélbúnaður flipinn sýnir hvað síminn þinn getur. Forritið er ókeypis og með opinn kóða. Skrárnar þínar fara aldrei úr símanum: það eina sem forritið sækir nokkurn tíma eru eigin uppfærslur þess, frá GitHub.</string>
    <string name="about_github">GitHub</string>
    <string name="about_github_sub">Upprunakóði, vandamál og verkefnasíðan</string>
    <string name="about_releases">Útgáfur</string>
    <string name="about_releases_sub">Sæktu nýjustu APK skrárnar</string>
    <string name="about_check_updates">Athuga með uppfærslur</string>
    <string name="about_check_updates_sub">Athugaðu á GitHub hvort nýrri útgáfa sé til</string>
    <string name="about_auto_check">Sjálfvirk uppfærsluathugun</string>
    <string name="about_auto_off">Slökkt. Forritið hefur engan netaðgang.</string>
    <string name="about_auto_daily">Einu sinni á dag, þegar forritið opnast</string>
    <string name="about_internet_note">Netheimildin fylgir uppsetningunni og er aðeins notuð til að athuga á GitHub eftir uppfærslum. Ef þú þarft ekki uppfærsluathuganir skaltu slökkva á sjálfvirku athuguninni. Ef forritið nær ekki á netið slekkur athugandinn á sér þar til hann getur það.</string>
    <string name="about_replay_tour">Spila ferðina aftur</string>
    <string name="about_replay_tour_sub">Sjáðu eiginleikaferðina aftur</string>
    <string name="about_footer">Byggt á FFmpeg í gegnum FFmpegKit (GPL), keyrir á miðlunarvélbúnaði símans þíns.</string>

    <!-- Feature tour -->
    <string name="tour_welcome_title">Velkomin í HWA Converter</string>
    <string name="tour_welcome_body">Þetta forrit umbreytir myndbandi og hljóði í símanum þínum. Það notar miðlunarvélina fyrst, ekki örgjörvann. Hér er stutt yfirlit.</string>
    <string name="tour_add_title">Bæta við skrám</string>
    <string name="tour_add_body">Ýttu á þennan hnapp og veldu skrárnar þínar. Ekkert byrjar enn. Þær bíða þar til þú ýtir á Byrja.</string>
    <string name="tour_pick_title">Veldu umbreytingu</string>
    <string name="tour_pick_body">Vélbúnaðarforstillingar eru fljótar og léttar á rafhlöðunni. Hugbúnaðarforstillingar eru hægari en gefa bestu gæðin. Sérsniðið veitir fulla stjórn á stillingum.</string>
    <string name="tour_start_title">Byrjaðu þegar þú vilt</string>
    <string name="tour_start_body">Eftir að þú bætir við skrám birtist Byrja hnappur fyrir neðan Bæta við skrám. Ýttu á hann til að byrja. Þangað til keyrir ekkert.</string>
    <string name="tour_queue_title">Biðröð flipinn</string>
    <string name="tour_queue_body">Allar umbreytingarnar þínar eru hér. Þú getur fylgst með framvindu og hraða, séð nákvæmlega þá skipun sem var keyrð og vistað villuleitarskrá verks.</string>
    <string name="tour_hardware_title">Vélbúnaðurinn þinn</string>
    <string name="tour_hardware_body">Þetta er miðlunarvélin inni í símanum þínum, könnuð á þessu tæki. Forstillingarnar þínar eru byggðar á henni. Ef vélbúnaðarleit er ekki á listanum hefur flagan þín hana ekki.</string>
    <string name="tour_settings_title">Útlit</string>
    <string name="tour_settings_body">Þemu, litastef, tungumál og níu ræsitákn eru hér.</string>
    <string name="tour_done_title">Það er allt</string>
    <string name="tour_done_body">Eitt að lokum. Umbreytingar keyra alfarið í símanum þínum. Það eina sem forritið sækir nokkurn tíma eru eigin uppfærslur þess.</string>
