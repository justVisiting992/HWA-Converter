    <string name="preset_h264_hw_label">H.264 · maskinvara</string>
    <string name="preset_h264_hw_desc">Snabb, liten, spelas överallt. Använder telefonens mediemotor.</string>
    <string name="preset_hevc_hw_label">H.265 / HEVC · maskinvara</string>
    <string name="preset_hevc_hw_desc">Ungefär hälften så stor som H.264 vid samma kvalitet. Använder telefonens mediemotor.</string>
    <string name="preset_vp9_hw_label">VP9 · maskinvara</string>
    <string name="preset_vp9_hw_desc">Maskinvaru-VP9 i en WebM-fil. Endast på telefoner vars mediemotor kodar VP9.</string>
    <string name="preset_av1_hw_label">AV1 · maskinvara</string>
    <string name="preset_av1_hw_desc">Maskinvaru-AV1. Endast ett fåtal mediemotorer kan koda AV1, så den här förinställningen visas bara på de telefonerna.</string>
    <string name="preset_h264_sw_label">H.264 · maxkvalitet (programvara)</string>
    <string name="preset_h264_sw_desc">Långsam processorkodning med libx264, bästa kvalitet per byte. För mastrar och HDR.</string>
    <string name="preset_hevc_sw_label">H.265 / HEVC · maxkvalitet (programvara)</string>
    <string name="preset_hevc_sw_desc">Mindre än H.264 vid samma kvalitet. Långsam processorkodning med libx265.</string>
    <string name="preset_vp9_sw_label">VP9 · programvara (WebM)</string>
    <string name="preset_vp9_sw_desc">Webbens kodek, i en WebM-fil. Processorkodning med libvpx.</string>
    <string name="preset_av1_sw_label">AV1 · programvara</string>
    <string name="preset_av1_sw_desc">Nyaste kodeken, minsta filerna. Mycket långsam på processorn. Bäst för korta klipp.</string>
