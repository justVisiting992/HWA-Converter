    <!-- About -->
    <string name="about_tagline">Mediekonvertering med maskinvara först</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_body">Hardware Accelerated Converter sätter telefonens mediemotor i arbete. De flesta konverteringsappar ignorerar den och kodar på processorn. Den här appen undersöker chippet först och använder maskinvaran när den kan. Programvaruvägen finns kvar för maximal kvalitet och för jobb som maskinvaran inte klarar. Inget faller tyst tillbaka. Varje jobb visar det exakta kommandot som kördes, och fliken Maskinvara visar vad din telefon klarar. Appen är gratis och öppen källkod. Dina filer lämnar aldrig telefonen: det enda appen någonsin hämtar är sina egna uppdateringar, från GitHub.</string>
    <string name="about_github">GitHub</string>
    <string name="about_github_sub">Källkod, ärenden och projektsidan</string>
    <string name="about_releases">Versioner</string>
    <string name="about_releases_sub">Ladda ner de senaste APK:erna</string>
    <string name="about_check_updates">Sök efter uppdateringar</string>
    <string name="about_check_updates_sub">Sök på GitHub efter en nyare version</string>
    <string name="about_auto_check">Automatisk uppdateringssökning</string>
    <string name="about_auto_off">Av. Appen har ingen nätverksåtkomst.</string>
    <string name="about_auto_daily">En gång om dagen, när appen öppnas</string>
    <string name="about_internet_note">Internetbehörigheten följer med installationen och används bara för att söka efter uppdateringar på GitHub. Om du inte behöver uppdateringssökningar, stäng av den automatiska sökningen. Om appen inte når internet stänger sökningen av sig själv tills den kan.</string>
    <string name="about_replay_tour">Spela upp rundturen igen</string>
    <string name="about_replay_tour_sub">Se funktionsrundturen igen</string>
    <string name="about_footer">Byggd på FFmpeg genom FFmpegKit (GPL), körs på telefonens mediemaskinvara.</string>

    <!-- Feature tour -->
    <string name="tour_welcome_title">Välkommen till HWA Converter</string>
    <string name="tour_welcome_body">Den här appen konverterar video och ljud på din telefon. Den använder mediemotorn först, inte processorn. Här är en snabb titt runt.</string>
    <string name="tour_add_title">Lägg till filer</string>
    <string name="tour_add_body">Tryck på den här knappen och välj dina filer. Inget startar ännu. De väntar tills du trycker på Start.</string>
    <string name="tour_pick_title">Välj en konvertering</string>
    <string name="tour_pick_body">Maskinvaruförinställningar är snabba och snälla mot batteriet. Programvaruförinställningar är långsammare men ger bästa kvalitet. Anpassad låter dig ställa in allt själv.</string>
    <string name="tour_start_title">Starta när du är redo</string>
    <string name="tour_start_body">När du har lagt till filer visas en Start-knapp under Lägg till filer. Tryck på den för att börja. Fram till dess körs inget.</string>
    <string name="tour_queue_title">Fliken Kö</string>
    <string name="tour_queue_body">Alla dina konverteringar bor här. Du kan följa förlopp och hastighet, se det exakta kommandot som kördes och spara ett jobbs felsökningslogg.</string>
    <string name="tour_hardware_title">Din maskinvara</string>
    <string name="tour_hardware_body">Det här är mediemotorn inuti din telefon, undersökt på den här enheten. Dina förinställningar byggs från den. Om en maskinvaruväg inte finns med har ditt chip den inte.</string>
    <string name="tour_settings_title">Utseende</string>
    <string name="tour_settings_body">Teman, färgscheman, språk och nio startprogramsikoner bor här.</string>
    <string name="tour_done_title">Det var allt</string>
    <string name="tour_done_body">En sista sak. Konverteringar körs helt på din telefon. Det enda appen någonsin laddar ner är sina egna uppdateringar.</string>
    <string name="tour_skip">Hoppa över</string>
    <string name="tour_next">Nästa</string>
    <string name="tour_got_it">Uppfattat</string>

