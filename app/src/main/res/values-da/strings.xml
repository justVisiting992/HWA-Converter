    <string name="preset_vp9_hw_desc">Hardware-VP9 i en WebM-fil. Kun på telefoner, hvis mediemotor koder VP9.</string>
    <string name="preset_av1_hw_label">AV1 · hardware</string>
    <string name="preset_av1_hw_desc">Hardware-AV1. Kun få mediemotorer kan kode AV1, så denne forudindstilling vises kun på de telefoner.</string>
    <string name="preset_h264_sw_label">H.264 · maks. kvalitet (software)</string>
    <string name="preset_h264_sw_desc">Langsom CPU-kodning med libx264, bedste kvalitet pr. byte. Til mastere og HDR.</string>
    <string name="preset_hevc_sw_label">H.265 / HEVC · maks. kvalitet (software)</string>
