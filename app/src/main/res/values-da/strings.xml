    <string name="preset_h264_hw_label">H.264 · hardware</string>
    <string name="preset_h264_hw_desc">Hurtig, lille, afspilles overalt. Bruger denne telefons mediemotor.</string>
    <string name="preset_hevc_hw_label">H.265 / HEVC · hardware</string>
    <string name="preset_hevc_hw_desc">Omkring halvt så stor som H.264 ved samme kvalitet. Bruger denne telefons mediemotor.</string>
