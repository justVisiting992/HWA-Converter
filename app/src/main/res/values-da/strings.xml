    <!-- About -->
    <string name="about_tagline">Mediekonvertering med hardware først</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_body">Hardware Accelerated Converter sætter din telefons mediemotor i arbejde. De fleste konverteringsapps ignorerer den og koder på CPU\'en. Denne app undersøger chippen først og bruger hardwaren, når den kan. Softwarestien bliver til maksimal kvalitet og til job, som hardwaren ikke kan klare. Intet falder stille tilbage. Hvert job viser den nøjagtige kommando, der kørte, og fanen Hardware viser, hvad din telefon kan. Appen er gratis og med åben kildekode. Dine filer forlader aldrig din telefon: det eneste, appen nogensinde henter, er dens egne opdateringer fra GitHub.</string>
    <string name="about_github">GitHub</string>
    <string name="about_github_sub">Kildekode, problemer og projektsiden</string>
    <string name="about_releases">Udgivelser</string>
    <string name="about_releases_sub">Download de nyeste APK\'er</string>
    <string name="about_check_updates">Søg efter opdateringer</string>
    <string name="about_check_updates_sub">Tjek GitHub for en nyere version</string>
    <string name="about_auto_check">Automatisk opdateringstjek</string>
    <string name="about_auto_off">Fra. Appen har ingen netværksadgang.</string>
    <string name="about_auto_daily">Én gang om dagen, når appen åbner</string>
    <string name="about_internet_note">Internettilladelsen følger med installationen og bruges kun til at tjekke GitHub for opdateringer. Hvis du ikke har brug for opdateringstjek, kan du slå det automatiske tjek fra. Hvis appen ikke kan nå internettet, deaktiverer tjekket sig selv, indtil det kan.</string>
    <string name="about_replay_tour">Afspil rundvisningen igen</string>
    <string name="about_replay_tour_sub">Se funktionsrundvisningen igen</string>
    <string name="about_footer">Bygget på FFmpeg gennem FFmpegKit (GPL), der kører på din telefons mediehardware.</string>

    <!-- Feature tour -->
    <string name="tour_welcome_title">Velkommen til HWA Converter</string>
    <string name="tour_welcome_body">Denne app konverterer video og lyd på din telefon. Den bruger mediemotoren først, ikke CPU\'en. Her er et hurtigt kig rundt.</string>
    <string name="tour_add_title">Tilføj filer</string>
    <string name="tour_add_body">Tryk på denne knap, og vælg dine filer. Intet starter endnu. De venter, indtil du trykker på Start.</string>
    <string name="tour_pick_title">Vælg en konvertering</string>
    <string name="tour_pick_body">Hardwareforudindstillinger er hurtige og skånsomme mod batteriet. Softwareforudindstillinger er langsommere, men giver den bedste kvalitet. Brugerdefineret lader dig indstille alt selv.</string>
    <string name="tour_start_title">Start, når du er klar</string>
    <string name="tour_start_body">Når du har tilføjet filer, vises en Start-knap under Tilføj filer. Tryk på den for at begynde. Indtil da kører intet.</string>
    <string name="tour_queue_title">Fanen Kø</string>
    <string name="tour_queue_body">Alle dine konverteringer bor her. Du kan se fremskridt og hastighed, se den nøjagtige kommando, der kørte, og gemme et jobs fejlfindinglog.</string>
    <string name="tour_hardware_title">Din hardware</string>
    <string name="tour_hardware_body">Dette er mediemotoren i din telefon, undersøgt på denne enhed. Dine forudindstillinger er bygget ud fra den. Hvis en hardwaresti ikke er på listen, har din chip den ikke.</string>
    <string name="tour_settings_title">Udseende</string>
    <string name="tour_settings_body">Temaer, farveskemaer, sprog og ni launcher-ikoner bor her.</string>
    <string name="tour_done_title">Det var det</string>
    <string name="tour_done_body">En sidste ting. Konverteringer kører helt på din telefon. Det eneste, appen nogensinde downloader, er dens egne opdateringer.</string>
    <string name="tour_skip">Spring over</string>
    <string name="tour_next">Næste</string>
    <string name="tour_got_it">Forstået</string>

