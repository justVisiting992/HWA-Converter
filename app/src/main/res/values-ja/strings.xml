    <!-- About -->
    <string name="about_tagline">ハードウェア優先のメディア変換</string>
    <string name="about_version">バージョン %1$s</string>
    <string name="about_body">Hardware Accelerated Converter はスマートフォンのメディアエンジンを活用します。多くの変換アプリはこれを無視して CPU でエンコードします。このアプリはまずチップを調べ、可能な限りハードウェアを使います。ソフトウェア経路は最高画質のため、そしてハードウェアではできないジョブのために残してあります。黙ってフォールバックすることはありません。すべてのジョブで実際に実行されたコマンドが表示され、ハードウェアタブではお使いのスマートフォンの能力を確認できます。このアプリは無料でオープンソースです。ファイルがスマートフォンの外に出ることはありません。このアプリが取得するのは GitHub からの自身のアップデートだけです。</string>
    <string name="about_github">GitHub</string>
    <string name="about_github_sub">ソースコード、問題報告、プロジェクトページ</string>
    <string name="about_releases">リリース</string>
    <string name="about_releases_sub">最新の APK をダウンロード</string>
    <string name="about_check_updates">アップデートを確認</string>
    <string name="about_check_updates_sub">GitHub で新しいバージョンを確認</string>
    <string name="about_auto_check">アップデートの自動確認</string>
    <string name="about_auto_off">オフ。このアプリにはネットワークアクセスがありません。</string>
    <string name="about_auto_daily">アプリを開いたときに 1 日 1 回</string>
    <string name="about_internet_note">インターネット権限はインストール時に付与され、GitHub でアップデートを確認するためだけに使われます。アップデート確認が不要なら、自動確認をオフにしてください。インターネットに接続できない場合、確認機能は接続できるまで自動的に無効になります。</string>
    <string name="about_replay_tour">ツアーを再生</string>
    <string name="about_replay_tour_sub">機能ツアーをもう一度見る</string>
    <string name="about_footer">FFmpegKit (GPL) を介した FFmpeg で構築され、お使いのスマートフォンのメディアハードウェアで動作します。</string>

    <!-- Feature tour -->
    <string name="tour_welcome_title">HWA Converter へようこそ</string>
    <string name="tour_welcome_body">このアプリはスマートフォンで動画と音声を変換します。CPU ではなく、まずメディアエンジンを使います。簡単にご案内します。</string>
    <string name="tour_add_title">ファイルを追加</string>
    <string name="tour_add_body">このボタンをタップしてファイルを選んでください。まだ何も始まりません。開始をタップするまで待機します。</string>
    <string name="tour_pick_title">変換を選ぶ</string>
    <string name="tour_pick_body">ハードウェアプリセットは高速でバッテリーにも優しいです。ソフトウェアプリセットは低速ですが最高の画質が得られます。カスタムではすべてを自分で設定できます。</string>
    <string name="tour_start_title">準備ができたら開始</string>
    <string name="tour_start_body">ファイルを追加すると、ファイルを追加ボタンの下に開始ボタンが表示されます。タップすると始まります。それまでは何も実行されません。</string>
    <string name="tour_queue_title">キュータブ</string>
    <string name="tour_queue_body">すべての変換はここに集まります。進捗と速度の確認、実行されたコマンドの表示、ジョブのデバッグログの保存ができます。</string>
    <string name="tour_hardware_title">お使いのハードウェア</string>
    <string name="tour_hardware_body">これはお使いのスマートフォン内部のメディアエンジンで、このデバイスで調べたものです。プリセットはこれをもとに作られます。ハードウェア経路が一覧にない場合、そのチップには搭載されていません。</string>
    <string name="tour_settings_title">外観</string>
    <string name="tour_settings_body">テーマ、カラースキーム、言語、9 種類のランチャーアイコンはここにあります。</string>
    <string name="tour_done_title">以上です</string>
    <string name="tour_done_body">最後に 1 つ。変換はすべてスマートフォン上で実行されます。このアプリがダウンロードするのは自身のアップデートだけです。</string>
