    <!-- Presets: labels and descriptions -->
    <string name="preset_h264_hw_label">H.264 · maskinvare</string>
    <string name="preset_h264_hw_desc">Rask, liten, spilles av overalt. Bruker mediemotoren på denne telefonen.</string>
    <string name="preset_hevc_hw_label">H.265 / HEVC · maskinvare</string>
    <string name="preset_hevc_hw_desc">Omtrent halvparten så stor som H.264 ved samme kvalitet. Bruker mediemotoren på denne telefonen.</string>
    <string name="preset_vp9_hw_label">VP9 · maskinvare</string>
    <string name="preset_vp9_hw_desc">Maskinvare-VP9 i en WebM-fil. Bare på telefoner der mediemotoren koder VP9.</string>
    <string name="preset_av1_hw_label">AV1 · maskinvare</string>
    <string name="preset_av1_hw_desc">Maskinvare-AV1. Bare noen få mediemotorer kan kode AV1, så denne forhåndsinnstillingen vises bare på de telefonene.</string>
    <string name="preset_h264_sw_label">H.264 · maks. kvalitet (programvare)</string>
    <string name="preset_h264_sw_desc">Treg CPU-koding med libx264, best kvalitet per byte. For mastere og HDR.</string>
    <string name="preset_hevc_sw_label">H.265 / HEVC · maks. kvalitet (programvare)</string>
    <string name="preset_hevc_sw_desc">Mindre enn H.264 ved samme kvalitet. Treg CPU-koding med libx265.</string>
    <string name="preset_vp9_sw_label">VP9 · programvare (WebM)</string>
    <string name="preset_vp9_sw_desc">Webbens kodek, i en WebM-fil. CPU-koding med libvpx.</string>
    <string name="preset_av1_sw_label">AV1 · programvare</string>
    <string name="preset_av1_sw_desc">Nyeste kodek, minste filer. Svært treg på CPU. Best for korte klipp.</string>
