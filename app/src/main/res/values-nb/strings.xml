    <!-- About -->
    <string name="about_tagline">Mediekonvertering med maskinvare først</string>
    <string name="about_version">Versjon %1$s</string>
    <string name="about_body">Hardware Accelerated Converter setter mediemotoren i telefonen din i arbeid. De fleste konverteringsapper ignorerer den og koder på CPU-en. Denne appen undersøker brikken først og bruker maskinvaren når den kan. Programvarestien blir igjen for maksimal kvalitet og for jobber maskinvaren ikke kan gjøre. Ingenting faller stille tilbake. Hver jobb viser den nøyaktige kommandoen som kjørte, og Maskinvare-fanen viser hva telefonen din kan. Appen er gratis og åpen kildekode. Filene dine forlater aldri telefonen: det eneste appen noen gang henter, er sine egne oppdateringer, fra GitHub.</string>
    <string name="about_github">GitHub</string>
    <string name="about_github_sub">Kildekode, saker og prosjektsiden</string>
    <string name="about_releases">Utgivelser</string>
    <string name="about_releases_sub">Last ned de nyeste APK-ene</string>
    <string name="about_check_updates">Se etter oppdateringer</string>
    <string name="about_check_updates_sub">Sjekk GitHub for en nyere versjon</string>
    <string name="about_auto_check">Automatisk oppdateringssjekk</string>
    <string name="about_auto_off">Av. Appen har ingen nettverkstilgang.</string>
    <string name="about_auto_daily">Én gang om dagen, når appen åpner</string>
    <string name="about_internet_note">Internett-tillatelsen følger med installasjonen og brukes bare til å sjekke GitHub for oppdateringer. Hvis du ikke trenger oppdateringssjekker, slå av den automatiske sjekken. Hvis appen ikke når internett, deaktiverer sjekken seg selv til den kan.</string>
    <string name="about_replay_tour">Spill av omvisningen på nytt</string>
    <string name="about_replay_tour_sub">Se funksjonsomvisningen igjen</string>
    <string name="about_footer">Bygget på FFmpeg gjennom FFmpegKit (GPL), som kjører på telefonens mediemaskinvare.</string>

    <!-- Feature tour -->
    <string name="tour_welcome_title">Velkommen til HWA Converter</string>
    <string name="tour_welcome_body">Denne appen konverterer video og lyd på telefonen din. Den bruker mediemotoren først, ikke CPU-en. Her er en rask titt rundt.</string>
    <string name="tour_add_title">Legg til filer</string>
    <string name="tour_add_body">Trykk på denne knappen og velg filene dine. Ingenting starter ennå. De venter til du trykker på Start.</string>
    <string name="tour_pick_title">Velg en konvertering</string>
    <string name="tour_pick_body">Maskinvareforhåndsinnstillinger er raske og snille mot batteriet. Programvareforhåndsinnstillinger er tregere, men gir best kvalitet. Tilpasset lar deg stille inn alt selv.</string>
    <string name="tour_start_title">Start når du er klar</string>
    <string name="tour_start_body">Etter at du har lagt til filer, vises en Start-knapp under Legg til filer. Trykk på den for å begynne. Før det kjører ingenting.</string>
    <string name="tour_queue_title">Kø-fanen</string>
    <string name="tour_queue_body">Alle konverteringene dine bor her. Du kan se fremdrift og hastighet, se den nøyaktige kommandoen som kjørte, og lagre en jobbs feilsøkingslogg.</string>
    <string name="tour_hardware_title">Maskinvaren din</string>
    <string name="tour_hardware_body">Dette er mediemotoren i telefonen din, undersøkt på denne enheten. Forhåndsinnstillingene dine er bygget fra den. Hvis en maskinvaresti ikke er listet, har ikke brikken din den.</string>
    <string name="tour_settings_title">Utseende</string>
    <string name="tour_settings_body">Temaer, fargeskjemaer, språk og ni oppstarterikoner bor her.</string>
    <string name="tour_done_title">Det var alt</string>
    <string name="tour_done_body">En siste ting. Konverteringer kjører helt på telefonen din. Det eneste appen noen gang laster ned, er sine egne oppdateringer.</string>
    <string name="tour_skip">Hopp over</string>
    <string name="tour_next">Neste</string>
    <string name="tour_got_it">Skjønner</string>

