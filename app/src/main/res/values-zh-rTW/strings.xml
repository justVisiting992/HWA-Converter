    <string name="preset_h264_hw_label">H.264 · 硬體</string>
    <string name="preset_h264_hw_desc">快速、體積小、到處可播放。使用此手機的媒體引擎。</string>
    <string name="preset_hevc_hw_label">H.265 / HEVC · 硬體</string>
    <string name="preset_hevc_hw_desc">相同品質下，體積約為 H.264 的一半。使用此手機的媒體引擎。</string>
    <string name="preset_vp9_hw_label">VP9 · 硬體</string>
    <string name="preset_vp9_hw_desc">WebM 檔案中的硬體 VP9。僅適用於媒體引擎可編碼 VP9 的手機。</string>
    <string name="preset_av1_hw_label">AV1 · 硬體</string>
    <string name="preset_av1_hw_desc">硬體 AV1。只有少數媒體引擎可以編碼 AV1，因此此預設僅在這些手機上顯示。</string>
    <string name="preset_h264_sw_label">H.264 · 最高品質（軟體）</string>
    <string name="preset_h264_sw_desc">使用 libx264 的慢速 CPU 編碼，每位元組品質最佳。適用於母帶和 HDR。</string>
    <string name="preset_hevc_sw_label">H.265 / HEVC · 最高品質（軟體）</string>
    <string name="preset_hevc_sw_desc">相同品質下比 H.264 更小。使用 libx265 的慢速 CPU 編碼。</string>
    <string name="preset_vp9_sw_label">VP9 · 軟體 (WebM)</string>
    <string name="preset_vp9_sw_desc">網路編解碼器，封裝為 WebM 檔案。使用 libvpx 的 CPU 編碼。</string>
    <string name="preset_av1_sw_label">AV1 · 軟體</string>
    <string name="preset_av1_sw_desc">最新的編解碼器，檔案最小。CPU 編碼非常慢。最適合短片。</string>
    <string name="preset_audio_aac_label">僅音訊 · AAC</string>
    <string name="preset_audio_aac_desc">將音軌擷取為 AAC。</string>
    <string name="preset_audio_mp3_label">僅音訊 · MP3</string>
    <string name="preset_audio_mp3_desc">將音軌擷取為 MP3。到處可播放。</string>
    <string name="preset_audio_opus_label">僅音訊 · Opus</string>
    <string name="preset_audio_opus_desc">將音軌擷取為 Opus。相同品質下體積最小。</string>
    <string name="preset_audio_flac_label">僅音訊 · FLAC</string>
    <string name="preset_audio_flac_desc">將音軌無損擷取為 FLAC。</string>
    <string name="preset_audio_wav_label">僅音訊 · WAV</string>
    <string name="preset_audio_wav_desc">將音軌以未壓縮形式擷取為 WAV，用於編輯。</string>
    <string name="preset_remux_mp4_label">重新封裝為 MP4 · 不重新編碼</string>
    <string name="preset_remux_mp4_desc">畫面和聲音不變，換上新的 MP4 容器。即時完成。</string>
    <string name="preset_remux_mkv_label">重新封裝為 MKV · 不重新編碼</string>
    <string name="preset_remux_mkv_desc">畫面和聲音不變，換上新的 MKV 容器。即時完成。</string>
    <string name="preset_trim_label">裁剪 · 不重新編碼</string>
    <string name="preset_trim_desc">不觸動畫面地剪出一段。剪切點落在關鍵影格上。</string>
    <string name="preset_gif_label">GIF · 動圖</string>
    <string name="preset_gif_desc">將片段轉換為動圖 GIF（12 fps，寬 480 px）。僅適合短片。</string>
    <string name="preset_custom_label">自訂 · 手動設定</string>
    <string name="preset_custom_desc">您自己的格式：容器、編解碼器、位元率、解析度。</string>

