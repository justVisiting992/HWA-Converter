    <!-- Feature tour -->
    <string name="tour_welcome_title">歡迎使用 HWA Converter</string>
    <string name="tour_welcome_body">此應用程式在您的手機上轉換影片和音訊。它優先使用媒體引擎，而不是 CPU。快速了解一下。</string>
    <string name="tour_add_title">加入檔案</string>
    <string name="tour_add_body">點按此按鈕並選擇您的檔案。還不會開始。它們會等待您點按開始。</string>
    <string name="tour_pick_title">選擇轉換</string>
    <string name="tour_pick_body">硬體預設快速且省電。軟體預設較慢，但品質最佳。自訂可讓您自己設定一切。</string>
    <string name="tour_start_title">準備好後開始</string>
    <string name="tour_start_body">加入檔案後，加入檔案按鈕下方會出現開始按鈕。點按它即可開始。在此之前，不會執行任何工作。</string>
    <string name="tour_queue_title">佇列分頁</string>
    <string name="tour_queue_body">您的所有轉換都在這裡。您可以查看進度和速度、查看實際執行的確切命令，並儲存工作的偵錯記錄。</string>
    <string name="tour_hardware_title">您的硬體</string>
    <string name="tour_hardware_body">這是您手機內部的媒體引擎，已在此裝置上偵測。您的預設就是基於它建立的。如果某個硬體路徑未列出，說明您的晶片沒有它。</string>
    <string name="tour_settings_title">外觀</string>
    <string name="tour_settings_body">主題、配色方案、語言和九個啟動器圖示都在這裡。</string>
    <string name="tour_done_title">就是這樣</string>
    <string name="tour_done_body">最後一件事。轉換完全在您的手機上執行。此應用程式唯一下載的是它自己的更新。</string>
